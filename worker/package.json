{
  "name": "worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "ci:build": "npm install && cd ../frontend && npm install && npm run build",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply finlit-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply finlit-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.86.0"
  }
}
